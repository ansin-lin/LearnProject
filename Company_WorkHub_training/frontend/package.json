{
  "name": "company-workhub-training-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "format:check": "prettier --check src vite.config.ts eslint.config.js package.json tsconfig.json index.html",
    "format": "prettier --write src vite.config.ts eslint.config.js package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@reduxjs/toolkit": "2.11.2",
    "axios": "1.20.0",
    "dayjs": "1.11.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.71.1",
    "react-redux": "9.2.0",
    "react-router-dom": "7.18.4",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.11",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.12.10",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
